{
  "name": "sprig-workbench",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "predev": "node scripts/check-node.mjs",
    "dev": "node scripts/dev.mjs",
    "predev:ui": "node scripts/check-node.mjs",
    "dev:ui": "node scripts/dev.mjs --ui-only",
    "typecheck": "tsc --noEmit && tsc -p store/tsconfig.json --noEmit && tsc -p store/tsconfig.client.json --noEmit && tsc -p channels/tsconfig.json --noEmit && tsc -p channels/tsconfig.client.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run test:store && npm run test:channels && npm run test:pricing && npm run build",
    "test:store": "npm --prefix store test && node --test test/store.integration.mjs",
    "seed": "node scripts/seed.mjs",
    "predemo:names": "node scripts/check-node.mjs",
    "demo:names": "node scripts/name-garden.mjs",
    "predemo:replay": "node scripts/check-node.mjs",
    "demo:replay": "node scripts/name-replay.mjs",
    "predemo:checkpoint": "node scripts/check-node.mjs",
    "demo:checkpoint": "node scripts/checkpoint-garden.mjs",
    "test:channels": "node --test --test-concurrency=1 channels/test/*.test.mjs",
    "test:pricing": "cd store && python3 -m unittest discover -s test -p 'test_*.py'"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "linkedom": "0.18.14",
    "miniflare": "5.20261023.0-beta",
    "typescript": "5.9.3"
  }
}
