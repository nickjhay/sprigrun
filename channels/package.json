{
  "name": "sprig-channels", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=neutral --external:cloudflare:workers --external:node:crypto --outfile=dist/worker.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run",
    "cli": "node scripts/channel.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1", "@types/node": "26.6.5", "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1", "miniflare": "5.20261023.0-beta", "typescript": "5.9.3", "wrangler": "4.153.0"
  }
}
