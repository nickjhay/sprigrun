{
  "name": "bounded-blob-store",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A bounded, content-addressed UTF-8 store on Cloudflare Workers, R2 and a Durable Object.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.client.json --noEmit",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=neutral --external:cloudflare:workers --external:node:crypto --outfile=dist/worker.mjs",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run",
    "admin": "node scripts/admin.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.0-beta",
    "typescript": "5.9.3",
    "wrangler": "4.153.0"
  }
}
